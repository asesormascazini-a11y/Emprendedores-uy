generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Emprendedor {
  id          String   @id @default(cuid())
  nombre      String
  descripcion String
  rubro       String
  departamento String
  ciudad      String?
  email       String?
  telefono    String?
  sitioWeb    String?
  instagram   String?
  logoUrl     String?
  publicado   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([rubro])
  @@index([departamento])
}
